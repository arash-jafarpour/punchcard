# Copy this file to $XDG_CONFIG_HOME/punchcard/env (or ~/.config/punchcard/env).
# The binary reads the file itself. Keep the mode at 0600.
# Lines are KEY=VALUE. An "export" prefix, # comments, and one pair of
# surrounding quote marks are permitted.

GITLAB_URL=https://replace-me
GITLAB_TOKEN=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
TELEGRAM_PROXY=socks5h://127.0.0.1:1089
REPORT_TIMEZONE=Asia/Tehran
REPORT_DIR=./reports
SEND_EMPTY_REPORT=true
